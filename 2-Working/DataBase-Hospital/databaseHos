CREATE TABLE USERS
(
  id BIGSERIAL PRIMARY KEY,
  username VARCHAR(50) NOT NULL,
  password VARCHAR(100)  NOT NULL,
  status INT NOT NULL,
  created_by VARCHAR(50)  ,
  created_date DATE ,
  updated_by VARCHAR(50) ,
  updated_date DATE ,
  phone VARCHAR(20) NOT NULL,
  email VARCHAR(35) ,
  fullname VARCHAR(50)  NOT NULL,
  date_of_birth DATE NOT NULL,
  roles VARCHAR(10)  NOT NULL
);

CREATE TABLE MAJOR
(
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(30)  NOT NULL,
  contens varchar(1000),
  image varchar(100),
  status INT NOT NULL,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50)  ,
  created_date DATE ,
  updated_date DATE
);

CREATE TABLE DOCTOR
(
  id BIGSERIAL PRIMARY KEY,
  degree VARCHAR(50) ,
  number_of_review INT NOT NULL,
  position varchar(20),
  total_points INT NOT NULL,
  image VARCHAR(300)  ,
  status INT NOT NULL,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE  ,
  user_id INT ,
  major_id INT ,
  FOREIGN KEY (user_id) REFERENCES USERS(id),
  FOREIGN KEY (major_id) REFERENCES MAJOR(id)
);

CREATE TABLE RECEPTIONIST
(
  id BIGSERIAL PRIMARY KEY,
  image VARCHAR(300)  ,
  status INT NOT NULL,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE  ,
  user_id INT ,
  FOREIGN KEY (user_id) REFERENCES USERS(id)
);

CREATE TABLE DISEASES
(
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(20)  NOT NULL,
  content VARCHAR(1000)  NOT NULL,
  image varchar(100),
  status INT NOT NULL,
  created_by VARCHAR(50)  ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE 
);

CREATE TABLE PATIENT
(
  id BIGSERIAL PRIMARY KEY,
  address VARCHAR(50) ,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  user_id INT,
  FOREIGN KEY (user_id) REFERENCES USERS(id)
);

CREATE TABLE ADMIN
(
  id BIGSERIAL PRIMARY KEY,
  position varchar(30), 
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  user_id INT NOT NULL,
  FOREIGN KEY (user_id) REFERENCES USERS(id)
);

CREATE TABLE ARTICLE
(
  id BIGSERIAL PRIMARY KEY,
  title VARCHAR(30) NOT NULL,
  image varchar(100),
  content VARCHAR(1000) NOT NULL,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  admin_id INT ,
  major_id INT,
  FOREIGN KEY (admin_id) REFERENCES ADMIN(id),
  FOREIGN KEY (major_id) REFERENCES MAJOR(id)
);

CREATE TABLE SCHEDULE
(
  id BIGSERIAL PRIMARY KEY,
  date_of_week VARCHAR(30) ,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT 
);

CREATE TABLE DOCTOR_SCHEDULE
(
  id BIGSERIAL PRIMARY KEY,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  doctor_id INT ,
  schedule_id INT ,
  FOREIGN KEY (doctor_id) REFERENCES DOCTOR(id),
  FOREIGN KEY (schedule_id) REFERENCES SCHEDULE(id)
);

CREATE TABLE SERVICE
(
  id BIGSERIAL PRIMARY KEY,
  name VARCHAR(30) NOT NULL,
  expensive INT NOT NULL,
  image VARCHAR(100),
  content VARCHAR(1000) NOT NULL,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  major_id INT ,
  FOREIGN KEY (major_id) REFERENCES MAJOR(id)
);

CREATE TABLE APPOINTMENT
(
  id BIGSERIAL PRIMARY KEY,
  note varchar(500) ,
date_of_week varchar(20),
appointment_date DATE,
 created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  patient_id INT ,
  doctor_id INT ,
  FOREIGN KEY (patient_id) REFERENCES PATIENT(id),
  FOREIGN KEY (doctor_id) REFERENCES DOCTOR(id)
);

CREATE TABLE MEDICAL_FILE
(
  id BIGSERIAL PRIMARY KEY,
  patient_illness VARCHAR(50) ,
  treatment_process VARCHAR(500) ,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  patient_id INT ,
  FOREIGN KEY (patient_id) REFERENCES PATIENT(id)
);

CREATE TABLE CONTACT
(
  id BIGSERIAL PRIMARY KEY,
  phone_hospital VARCHAR(50) NOT NULL,
  email_hospital VARCHAR(50) NOT NULL,
 created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT 
);

CREATE TABLE RECRUITMENT
(
  id BIGSERIAL PRIMARY KEY,
  job_vacancy VARCHAR(20) ,
  start_date DATE ,
  end_date DATE ,
  salary VARCHAR(20) ,
  required VARCHAR(300) ,
  describes VARCHAR(300) ,
  created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT 
);

CREATE TABLE DISEASES_MAJOR
(
  id BIGSERIAL PRIMARY KEY,
 created_by VARCHAR(50) ,
  updated_by VARCHAR(50) ,
  created_date DATE ,
  updated_date DATE ,
  status INT ,
  major_id INT ,
  diseases_id INT ,
  FOREIGN KEY (major_id) REFERENCES MAJOR(id),
  FOREIGN KEY (diseases_id) REFERENCES DISEASES(id)
);
